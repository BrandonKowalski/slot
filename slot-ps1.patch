diff -ruN a/.github/workflows/ps1.yml b/.github/workflows/ps1.yml
--- a/.github/workflows/ps1.yml	1970-01-01 00:00:00.000000000 +0000
+++ b/.github/workflows/ps1.yml	2026-10-12 06:07:09.281239608 +0000
@@ -0,0 +1,60 @@
+name: ps1
+
+# Builds the slot binary with PlayStation support and a PCSX ReARMed core for the H700, in the
+# same bullseye container the release workflow uses so both load on the device's libc.
+# Copy the two files in the artifact onto SD2 (System/) over an existing slot install.
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+    paths:
+      - 'crates/**'
+      - '.github/workflows/ps1.yml'
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    name: slot and pcsx_rearmed
+    runs-on: ubuntu-24.04-arm
+    container: rust:1-bullseye
+    steps:
+      - uses: actions/checkout@v7
+
+      - name: Install build tools
+        run: |
+          set -eu
+          sed -i '/bullseye-security/d' /etc/apt/sources.list
+          apt-get -o Acquire::Check-Valid-Until=false update
+          apt-get install -y --no-install-recommends zip git make gcc g++ file
+
+      - name: Build slot
+        run: cargo build --profile device -p slot --no-default-features --features device
+
+      - name: Build PCSX ReARMed
+        run: |
+          set -eu
+          git clone --depth 1 --recurse-submodules https://github.com/libretro/pcsx_rearmed.git /tmp/pcsx
+          git -C /tmp/pcsx rev-parse HEAD > /tmp/pcsx.commit
+          make -C /tmp/pcsx -f Makefile.libretro -j"$(nproc)"
+          file /tmp/pcsx/pcsx_rearmed_libretro.so | grep -q aarch64
+
+      - name: Package
+        run: |
+          set -eu
+          out=slot-ps1-update
+          mkdir -p "$out/System/licenses"
+          file target/device/slot | grep -q aarch64
+          cp target/device/slot "$out/System/slot"
+          cp /tmp/pcsx/pcsx_rearmed_libretro.so "$out/System/"
+          cp /tmp/pcsx/COPYING "$out/System/licenses/pcsx_rearmed-GPL-2.0.txt" 2>/dev/null || true
+          cp /tmp/pcsx.commit "$out/System/licenses/pcsx_rearmed.commit"
+          zip -qry "$out.zip" "$out"
+
+      - uses: actions/upload-artifact@v7
+        with:
+          name: slot-ps1-update
+          path: slot-ps1-update.zip
+          if-no-files-found: error
