+            font,
+            title,
+            w as f32 * 0.56,
+            h as f32 * 0.30,
+            MAX_LINES,
+            34.0,
+            MIN_PX,
+        );
+        text::draw_centred(&mut rgba, w, h, &layout, ink(bg));
+    }
+    rgba
+}
