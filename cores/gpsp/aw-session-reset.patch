 // Netplay session ends.
 static void netpacket_stop() {
   netpacket_send_fn_ptr = NULL;
   netpacket_pollrcv_fn_ptr = NULL;
+  /* Restore the lone-master identity a non-networked GBA has. Left at 1 (the
+   * joiner's id), the game keeps taking the slave IRQ path (serialaw_update
+   * fires on `netplay_client_id`) and draining serstate for a peer that is no
+   * longer there — both between sessions and, if these statics survive an
+   * in-process core reload, into the next session's netpacket_start. */
+  netplay_client_id = 0;
+  netplay_num_clients = 0;
+  /* Leave no stale peer buffers behind for the next session or for single
+   * player, matching the fresh state a mode transition would have produced. */
+  serialproto_reset();
 }
 
