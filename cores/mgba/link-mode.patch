+/* Link mode's retro_run: both players' buttons, both GBAs one frame, then the local player's
+ * picture and sound. The other GBA's sound is thrown away. */
+static void _linkRunFrame(void) {
+	int i;
+	for (i = 0; i < 2; ++i) {
+		linkGba[i].core->setKeys(linkGba[i].core, _linkReadKeys(i));
+	}
+	_linkStep();
+	_postFrame(false);
+	struct mCore* peer = linkGba[1 - linkPlayer].core;
+	mAudioBufferClear(peer->getAudioBuffer(peer));
+}
