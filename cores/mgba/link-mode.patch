+/* Steps both GBAs one video frame, taking turns on this thread.
+ *
+ * The coordinator puts a GBA to sleep while it waits on the other, and a sleeping GBA only
+ * flips its flag, so whichever GBA is awake and short of its frame runs next. Every choice
+ * depends only on emulated state, so the same starting states and buttons make the same
+ * machines on every device.
+ *
+ * Every join is in phase (_linkPlugIn): both GBAs' frames end at the same moment on the cable's
+ * clock. A GBA that has finished its frame cannot simply stop while the other sleeps waiting on
+ * it: that is the deadlock a strict per-frame barrier falls into. The cable keeps player 1 behind
+ * player 0's clock, so player 0 finishes while player 1 still sleeps short of its own frame. A
+ * finished player 0 syncs the cable there, at its frame boundary, instead of running on: its
+ * lockstep event fires at once, which moves the shared clock to player 0's frame end and wakes
+ * player 1 to finish. Run on, player 0 would reach its next frame's KEYINPUT read before that
+ * frame's buttons are set, and read them a frame late.
+ *
+ * A finished player 1 still runs on, with the same buttons, while player 0 sleeps waiting on it
+ * for a transfer or a hard sync, since the cable needs player 1 to reach that moment first. In
+ * phase, player 0 only waits at or before its own frame end, which is player 1's too, so that
+ * run-on stops at player 1's frame end, give or take the few cycles two frames in phase can end
+ * apart, and never reaches its next KEYINPUT read.
+ *
+ * A frame is done when the video frame counter moves, or after as many cycles as
+ * _GBACoreRunFrame allows one, so a GBA whose video has stopped cannot hold this loop. */
+static void _linkStep(void) {
+	uint32_t target[2];
+	uint32_t start[2];
+	bool done[2] = { false, false };
+	int i;
+	for (i = 0; i < 2; ++i) {
+		struct GBA* gba = linkGba[i].core->board;
+		target[i] = gba->video.frameCounter + 1;
+		start[i] = mTimingCurrentTime(&gba->timing);
+	}
+	while (!done[0] || !done[1]) {
+		bool ran = false;
+		for (i = 0; i < 2; ++i) {
+			struct LinkGBA* self = &linkGba[i];
+			struct LinkGBA* other = &linkGba[1 - i];
+			if (self->asleep) {
+				continue;
+			}
+			if (done[i] && (done[1 - i] || !other->asleep)) {
+				continue;
+			}
+			struct GBA* gba = self->core->board;
+			/* Here a finished player 0 only runs because player 1 sleeps short of its frame.
+			 * With no transfer or hard sync pending, firing the lockstep event now syncs the
+			 * cable at player 0's frame boundary, where running would carry it into the next
+			 * frame on this frame's buttons. The run loop is also asked to return as soon as
+			 * that event has fired. A CPU blocked by a DMA, or halted waiting on an interrupt,
+			 * otherwise goes on through event after event until one asks it to stop, and the
+			 * lockstep event only wakes player 1: player 0 would run on to its next vblank, end
+			 * two frames in one step, and leave player 1 a whole frame behind for the rest of the
+			 * session. Mario Kart: Super Circuit's boot reaches its first frame end inside a DMA. */
+			if (i == 0 && done[0] && !linkCoordinator.transferActive && !linkCoordinator.waiting) {
+				mTimingDeschedule(&gba->timing, &self->driver.event);
+				mTimingSchedule(&gba->timing, &self->driver.event, 0);
+				gba->earlyExit = true;
+			}
+			self->core->runLoop(self->core);
+			ran = true;
+			if (gba->video.frameCounter >= target[i] ||
+			    (uint32_t) mTimingCurrentTime(&gba->timing) - start[i] >= VIDEO_TOTAL_LENGTH + VIDEO_HORIZONTAL_LENGTH) {
+				done[i] = true;
+			}
+		}
+		if (!ran) {
+			if (!linkStuck) {
+				fprintf(stderr, "mgba: link: neither GBA can run (asleep %d/%d, done %d/%d)\n",
+				        linkGba[0].asleep, linkGba[1].asleep, done[0], done[1]);
+				linkStuck = true;
+			}
+			return;
+		}
+	}
+}
