+/* One player's buttons from their own input port, mapped the way retro_run maps port 0 but
+ * without its turbo buttons: turbo keeps a clock of its own, which two SPs would not share. */
+static uint16_t _linkReadKeys(unsigned port) {
+	uint16_t keys = 0;
+	unsigned i;
+	if (useBitmasks) {
+		int16_t joypadMask = inputCallback(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_MASK);
+		for (i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= ((joypadMask >> keymap[i]) & 1) << i;
+		}
+	} else {
+		for (i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= (!!inputCallback(port, RETRO_DEVICE_JOYPAD, 0, keymap[i])) << i;
+		}
+	}
+	return keys;
+}
