+
+/* Whether a GBA stands where _linkStep leaves one whose frame is done, which is where a lone
+ * core's frame leaves it too: its video has started the vblank, on VCOUNT 160, and has not yet
+ * reached that line's hblank. Both stop a GBA at the first return from its run loop after the
+ * frame counter moves, and that return always comes before the hblank. It is read from the
+ * video state, which a savestate carries, so a restored GBA answers for itself. */
+static bool _linkAtFrameEnd(struct GBA* gba) {
+	return gba->video.vcount == GBA_VIDEO_VERTICAL_PIXELS &&
+	    !GBARegisterDISPSTATIsInHblank(gba->memory.io[GBA_REG(DISPSTAT)]);
+}
+
+/* Runs a GBA that is not at a frame end on its own until its frame ends: at most one frame, the
+ * most a lone core's frame runs, with no cable, the buttons released, and the picture and sound
+ * it makes thrown away. A GBA already at a frame end does not run. */
+static void _linkRunToFrameEnd(struct mCore* gbaCore) {
+	if (_linkAtFrameEnd(gbaCore->board)) {
+		return;
+	}
+	gbaCore->setKeys(gbaCore, 0);
+	gbaCore->runFrame(gbaCore);
+	mAudioBufferClear(gbaCore->getAudioBuffer(gbaCore));
+}
+
+/* Plugs a fresh coordinator and cable into both GBAs, and only once both stand at a frame end, so
+ * every join is in phase: from the join on, both GBAs' frames end at the same moment on the
+ * cable's clock. Where each GBA stands in its frame when the cable goes in fixes that for the
+ * session, and a link state may pair any two GBA states, so each GBA that is not at a frame end
+ * is first run on its own to its next one. Two states taken at a frame end, which is how every
+ * session starts, go in as they are.
+ *
+ * Both clocks stop following the device before anything runs: a fixed epoch plus emulated time,
+ * read as UTC, with no offset from a save file's RTC data (which a reset works out in the device's
+ * timezone), since each SP runs both GBAs and a wall clock or a timezone would tell the copies
+ * apart. The cable then goes in the order mGBA's own MultiplayerController uses: attach, then set
+ * the peripheral, whose reset registers the player. Player 0 goes first, so the ids handed out
+ * match the players. */
+static void _linkPlugIn(void) {
+	int i;
+	for (i = 0; i < 2; ++i) {
+		struct mCore* gbaCore = linkGba[i].core;
+		gbaCore->rtc.override = RTC_FAKE_EPOCH;
+		gbaCore->rtc.value = LINK_RTC_EPOCH_MS;
+		((struct GBA*) gbaCore->board)->memory.hw.rtc.utc = true;
+		((struct GBA*) gbaCore->board)->memory.hw.rtc.offset = 0;
+	}
+	for (i = 0; i < 2; ++i) {
+		_linkRunToFrameEnd(linkGba[i].core);
+	}
+	GBASIOLockstepCoordinatorInit(&linkCoordinator);
+	for (i = 0; i < 2; ++i) {
+		struct LinkGBA* player = &linkGba[i];
+		player->id = i;
+		player->asleep = false;
+		player->d.sleep = _linkSleep;
+		player->d.wake = _linkWake;
+		player->d.requestedId = _linkRequestedId;
+		player->d.playerIdChanged = _linkPlayerIdChanged;
+		GBASIOLockstepDriverCreate(&player->driver, &player->d);
+		GBASIOLockstepCoordinatorAttach(&linkCoordinator, &player->driver);
+		player->core->setPeripheral(player->core, mPERIPH_GBA_LINK_PORT, &player->driver.d);
+	}
+	linkPlugged = true;
+	linkStuck = false;
+}
+
+/* Pulls the cable out of both GBAs and throws the coordinator away. */
+static void _linkUnplug(void) {
+	if (!linkPlugged) {
+		return;
+	}
+	int i;
+	for (i = 0; i < 2; ++i) {
+		linkGba[i].core->setPeripheral(linkGba[i].core, mPERIPH_GBA_LINK_PORT, NULL);
+		GBASIOLockstepCoordinatorDetach(&linkCoordinator, &linkGba[i].driver);
+	}
+	GBASIOLockstepCoordinatorDeinit(&linkCoordinator);
+	linkPlugged = false;
+}
+
+/* The other player's GBA: the same game on a core of its own, with its own screen, its own
+ * cartridge save and `core`'s settings. It gets no device peripherals, and in link mode neither
+ * does `core`: a light or tilt sensor on one SP is not there for the other SP's copy. */
+static bool _linkCreatePeer(const struct retro_game_info* game, const char* biosPath) {
+	struct VFile* rom = data ? VFileFromMemory(data, dataSize) : VFileOpen(game->path, O_RDONLY);
+	if (!rom) {
+		return false;
+	}
+	struct mCore* peer = mCoreFindVF(rom);
+	if (!peer) {
+		rom->close(rom);
+		return false;
+	}
+	mCoreInitConfig(peer, NULL);
+	peer->init(peer);
+	mCoreLoadForeignConfig(peer, &core->config);
+
+	peerOutputBuffer = malloc(VIDEO_BUFF_SIZE);
+	memset(peerOutputBuffer, 0xFF, VIDEO_BUFF_SIZE);
+	peer->setVideoBuffer(peer, peerOutputBuffer, VIDEO_WIDTH_MAX);
+	peerSavedata = anonymousMemoryMap(GBA_SIZE_FLASH1M);
+	memset(peerSavedata, 0xFF, GBA_SIZE_FLASH1M);
+	peer->loadROM(peer, rom);
+#ifdef ENABLE_VFS
+	if (biosPath) {
+		struct VFile* bios = VFileOpen(biosPath, O_RDONLY);
+		if (bios) {
+			peer->loadBIOS(peer, bios, 0);
+		}
+	}
+#else
+	UNUSED(biosPath);
+#endif
+
+	memset(linkGba, 0, sizeof(linkGba));
+	linkGba[linkPlayer].core = core;
+	linkGba[1 - linkPlayer].core = peer;
+	return true;
+}
+
+/* The other GBA's half of _doDeferredSetup, then the cable. */
+static void _linkDeferredSetup(void) {
+	struct mCore* peer = linkGba[1 - linkPlayer].core;
+	struct VFile* save = VFileFromMemory(peerSavedata, GBA_SIZE_FLASH1M);
+	_linkUnplug();
+	peer->reset(peer);
+	if (!peer->loadSave(peer, save)) {
+		save->close(save);
+	}
+	_linkPlugIn();
+}
+
+static void _linkUnload(void) {
+	_linkUnplug();
+	struct mCore* peer = linkGba[1 - linkPlayer].core;
+	mCoreConfigDeinit(&peer->config);
+	peer->deinit(peer);
+	free(peerOutputBuffer);
+	peerOutputBuffer = NULL;
+	mappedMemoryFree(peerSavedata, GBA_SIZE_FLASH1M);
+	peerSavedata = NULL;
+	memset(linkGba, 0, sizeof(linkGba));
+	linkMode = false;
+}
