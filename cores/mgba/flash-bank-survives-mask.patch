+static ptrdiff_t _flashBankOffset(const struct GBASavedata* savedata) {
+	if ((savedata->type != GBA_SAVEDATA_FLASH512 && savedata->type != GBA_SAVEDATA_FLASH1M) || !savedata->data || !savedata->currentBank) {
+		return 0;
+	}
+	return savedata->currentBank - savedata->data;
+}
+
+static void _flashRestoreBank(struct GBASavedata* savedata, ptrdiff_t bank) {
+	if (savedata->type == GBA_SAVEDATA_FLASH1M && savedata->data) {
+		savedata->currentBank = &savedata->data[bank];
+	}
+}
