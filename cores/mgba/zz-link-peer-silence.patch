+++ b/src/platform/libretro/libretro.c
@@ -2035,6 +2035,11 @@
 	 * The counter renders one frame and then reloads from this, so the peer draws its first frame
 	 * and none after it. */
 	((struct GBA*) peer->board)->video.frameskip = INT_MAX;
+	/* And its sound is never played either. Same argument, smaller: the expensive half of the
