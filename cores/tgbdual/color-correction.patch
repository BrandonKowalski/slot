+// Game Boy Color screen simulation, off by default.
+//
+// A CGB game writes palette values meant for the console's own LCD, which is dimmer and far less
+// saturated than a modern panel. Shown literally, those colours come out harsh and oversaturated.
+// The transform below is the long-standing approximation of that screen used across emulators:
+// each output channel is a fixed blend of the three input channels, which desaturates and warms
+// the picture without touching its brightness ordering.
+//
+// Applied to the finished framebuffer rather than in map_color, and that placement is the whole
+// design. map_color has an inverse, unmap_color, which a game reads its own palette back through
+// (gb_core/cpu.cpp, the BCPD register). Correcting there would make the pair no longer inverses
+// and would hand a game colours it never wrote, which is a change to emulated behaviour rather
+// than to how the result is displayed. Here nothing the console can observe is touched.
+//
+// The cost is one table lookup per pixel. The table is 128 KB and is rebuilt only when the option
+// changes, so a frame pays 23,040 lookups per screen and no arithmetic at all.
+static bool _color_correction = false;
+static bool _correction_table_ready = false;
+static word _correction_table[0x10000];
+
+static void build_correction_table(void)
+{
+   for (int c = 0; c < 0x10000; ++c)
+   {
+      // RGB565 in, RGB565 out. The blend is defined on 5-bit channels, so green is brought down
+      // to five bits for the arithmetic and returned to six, which keeps the three channels on
+      // one scale rather than giving green a quietly different weight.
+      int r = (c >> 11) & 0x1f;
+      int g = (c >> 6) & 0x1f;
+      int b = c & 0x1f;
+      int nr = (r * 26 + g * 4 + b * 2) / 32;
+      int ng = (g * 24 + b * 8) / 32;
+      int nb = (r * 6 + g * 4 + b * 22) / 32;
+      if (nr > 31) nr = 31;
+      if (ng > 31) ng = 31;
+      if (nb > 31) nb = 31;
+      _correction_table[c] = (word)((nr << 11) | (ng << 6) | nb);
+   }
+   _correction_table_ready = true;
+}
+
+void dmy_renderer::set_color_correction(bool on)
+{
+   if (on && !_correction_table_ready)
+      build_correction_table();
+   _color_correction = on;
+}
+
+// In place over the buffer about to be shown. Every caller below hands this a buffer it owns.
+static void apply_color_correction(byte *buf, int bytes)
+{
+   if (!_color_correction)
+      return;
+   word *px = (word *)buf;
+   int n = bytes / 2;
+   for (int i = 0; i < n; ++i)
+      px[i] = _correction_table[px[i]];
+}
+
